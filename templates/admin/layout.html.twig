<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Back-office | Voyage Maison{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --admin-ink: #0f172a;
            --admin-muted: #64748b;
            --admin-line: rgba(15, 23, 42, 0.10);
            --admin-surface: rgba(255, 255, 255, 0.78);
            --admin-accent: #ff5a5f;
            --admin-accent-dark: #e54d52;
            --admin-bg: #f5f7fb;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(255, 90, 95, 0.12), transparent 24%),
                radial-gradient(circle at 85% 10%, rgba(59, 130, 246, 0.10), transparent 20%),
                linear-gradient(180deg, #f8fafc 0%, #eef3f9 55%, #e8edf4 100%);
            color: var(--admin-ink);
            font-family: 'Inter', 'Segoe UI', sans-serif;
        }

        .admin-shell { min-height: 100vh; }

        .admin-topbar {
            backdrop-filter: blur(18px);
            background: rgba(255, 255, 255, 0.72);
            border-bottom: 1px solid var(--admin-line);
        }

        .brand-mark {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 0.9rem;
            background: linear-gradient(135deg, var(--admin-accent), #ff8c7a);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            box-shadow: 0 14px 24px rgba(255, 90, 95, 0.25);
        }

        .brand-title {
            font-family: 'Fraunces', Georgia, serif;
            letter-spacing: -0.02em;
        }

        .admin-badge {
            background: rgba(255, 90, 95, 0.09);
            color: var(--admin-accent-dark);
            border: 1px solid rgba(255, 90, 95, 0.15);
        }

        .admin-layout {
            display: grid;
            grid-template-columns: 300px minmax(0, 1fr);
            min-height: calc(100vh - 73px);
        }

        .admin-sidebar {
            background: rgba(255, 255, 255, 0.60);
            border-right: 1px solid var(--admin-line);
            padding: 1.25rem;
        }

        .sidebar-card {
            border: 1px solid var(--admin-line);
            background: var(--admin-surface);
            border-radius: 1.4rem;
            padding: 1rem;
            box-shadow: 0 16px 30px rgba(15, 23, 42, 0.05);
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.8rem 0.9rem;
            border-radius: 0.95rem;
            border: 1px solid transparent;
            color: var(--admin-ink);
            text-decoration: none;
            background: rgba(255, 255, 255, 0.52);
        }

        .sidebar-nav a.active,
        .sidebar-nav a:hover {
            border-color: rgba(255, 90, 95, 0.18);
            background: rgba(255, 90, 95, 0.06);
        }

        .sidebar-label {
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--admin-muted);
            margin-bottom: 0.65rem;
        }

        .admin-main { padding: 1.4rem; }

        .admin-page-shell {
            border: 1px solid var(--admin-line);
            background: rgba(255, 255, 255, 0.66);
            border-radius: 1.8rem;
            box-shadow: 0 18px 36px rgba(15, 23, 42, 0.05);
            padding: 1.25rem;
        }

        .hero-panel {
            border-radius: 1.6rem;
            background:
                linear-gradient(135deg, rgba(15, 23, 42, 0.94), rgba(30, 41, 59, 0.90)),
                url('https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80') center/cover;
            color: #fff;
            padding: 1.6rem;
            min-height: 230px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .hero-panel h1,
        .section-title {
            font-family: 'Fraunces', Georgia, serif;
            letter-spacing: -0.02em;
        }

        .hero-meta {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .glass-chip {
            border-radius: 999px;
            padding: 0.45rem 0.75rem;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #fff;
            font-size: 0.85rem;
        }

        .kpi-card {
            border: 1px solid var(--admin-line);
            border-radius: 1.3rem;
            background: rgba(255, 255, 255, 0.78);
            padding: 1rem;
            box-shadow: 0 14px 26px rgba(15, 23, 42, 0.05);
            height: 100%;
        }

        .kpi-label {
            color: var(--admin-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        .kpi-value {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1;
            margin-top: 0.35rem;
        }

        .kpi-note {
            color: var(--admin-muted);
            margin-top: 0.65rem;
            font-size: 0.92rem;
        }

        .section-card {
            border: 1px solid var(--admin-line);
            border-radius: 1.3rem;
            background: rgba(255, 255, 255, 0.82);
            box-shadow: 0 14px 26px rgba(15, 23, 42, 0.04);
        }

        .section-card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--admin-line);
        }

        .table thead th {
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 0.75rem;
            color: var(--admin-muted);
            border-top: 0;
        }

        .table td,
        .table th { vertical-align: middle; }

        .muted-small {
            color: var(--admin-muted);
            font-size: 0.9rem;
        }

        @media (max-width: 992px) {
            .admin-layout { grid-template-columns: 1fr; }
            .admin-sidebar { border-right: 0; border-bottom: 1px solid var(--admin-line); }
        }

        @media (max-width: 576px) {
            .admin-main { padding: 1rem; }
            .admin-page-shell { padding: 1rem; border-radius: 1.2rem; }
            .hero-panel { min-height: auto; }
        }
    </style>
</head>
<body>
<div class="admin-shell">
    <header class="admin-topbar py-3">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-mark">VM</div>
                    <div>
                        <div class="small text-uppercase text-muted fw-semibold">Back-office</div>
                        <div class="brand-title fs-4 mb-0">Voyage Maison</div>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="/" class="btn btn-outline-secondary btn-sm">Voir le site</a>
                    {% if app.user %}
                        <a href="{{ path('app_admin_logout') }}" class="btn btn-dark btn-sm">Déconnexion</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    <div class="admin-layout">
        <aside class="admin-sidebar d-none d-lg-block">
            <div class="sidebar-card">
                <div class="sidebar-label">Navigation</div>
                <div class="sidebar-nav">
                    <a href="{{ path('app_admin') }}"><span>Dashboard</span><span>→</span></a>
                    <a href="{{ path('admin_properties_index') }}"><span>Logements</span><span>→</span></a>
                    <a href="{{ path('admin_bookings_index') }}"><span>Réservations</span><span>→</span></a>
                    <a href="/admin/login"><span>Connexion admin</span><span>→</span></a>
                    <a href="/"><span>Site client</span><span>→</span></a>
                </div>
            </div>
        </aside>

        <main class="admin-main">
            <div class="admin-page-shell">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'danger' ? 'danger' : label }} mb-3">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
</div>
</body>
</html>